{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CuiCall",
  "version": "0.3.0",
  "identifier": "com.cuicall.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "CuiCall Desktop",
        "width": 1200,
        "height": 750,
        "minWidth": 900,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "cuicall"
        ]
      }
    },
    "updater": {
      "endpoints": [
        "https://github.com/TavossX/CuiCall/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQzRjdFNUY4NUVEMjM2RDEKUldUUk50SmUrT1gzUThhLysrQ3hRRG1vYlRaSWQ1WlJLTUxQUHB0U1E2SVdqQ0FkQy9nR3VQQk8K"
    }
  }
}
